# Preserve supplied source and archived HTTP response bytes on every platform.
code/** -text
docs/lab4/guide/** -text
*.zip -text
*.pdf -text
*.png -text
*.ico -text
*.woff -text
*.woff2 -text
*.ttf -text
*.eot -text

# Authored text is portable LF text.
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.txt text eol=lf

# Keep teammate C's existing evidence and test files byte-identical.
code/tools/member-c/** -text whitespace=cr-at-eol
